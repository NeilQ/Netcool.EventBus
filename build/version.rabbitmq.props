<Project>
	<PropertyGroup>
        <Version>2.3</Version>
        <Authors>邱尘</Authors>
        <Description>An EventBus base on netstandard2 and RabbitMq.</Description>
        <PackageTags>EventBus,RabbitMq</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReleaseNotes>
            - Stop throwing exception when subscribe duplicate event.
            - Add HandleSynchronously and UnbindOnUnsubscribe EventBusRabbitMqOptions.
            - Dispose consume channel when the subscribe list is empty.
        </PackageReleaseNotes>
        <RepositoryUrl>https://github.com/NeilQ/Netcool.EventBus</RepositoryUrl>
	</PropertyGroup>
</Project>
